# ==========================================
# PRIVATE LIVE PLATFORM - ENVIRONMENT VARIABLES
# ==========================================

# Ambientes: development | production
NODE_ENV=production

# Porta da aplicação (definida automaticamente pelo Railway)
PORT=3001

# Volume de dados persistentes no Railway
DATA_DIR=/data

# URL Pública do seu site
PUBLIC_SITE_URL=https://seusite.com

# Senha de Acesso ao Painel Admin (/admin)
ADMIN_PASSWORD=SuaSenhaSeguraAqui123!

# Chave Secreta para Assinatura HMAC dos Cookies de Sessão (64 caracteres)
ADMIN_SESSION_SECRET=b654e58b528a4be0841f3e7904724b17a10be69cb4589d81d77a8346cb32cf5e

# ==========================================
# NEXUSPAG GATEWAY PIX
# ==========================================
NEXUSPAG_API_KEY=sua_chave_nexuspag_aqui
NEXUSPAG_WEBHOOK_SECRET=seu_segredo_webhook_nexuspag_aqui

# ==========================================
# CLOUDFLARE TURNSTILE (Opcional - Anti-Bot)
# ==========================================
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
